  "description": "A typescript developed HTTP server without using http libraries, and just using raw TCP.",
  "packageManager": "npm@11.13.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
