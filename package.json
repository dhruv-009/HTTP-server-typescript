  "bugs": {
    "url": "https://github.com/dhruv-009/HTTP-server-typescript/issues"
  },
  "homepage": "https://github.com/dhruv-009/HTTP-server-typescript#readme",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
